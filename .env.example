# Required in production
MONGODB_URI=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GOOGLE_GEMINI_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Required in production; use the canonical HTTPS application URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Required in production for distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional rate-limit overrides
RATE_LIMIT_CHAT_MAX_REQUESTS=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX_REQUESTS=5
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_KNOWLEDGE_MAX_REQUESTS=5
RATE_LIMIT_KNOWLEDGE_WINDOW_SECONDS=600

# Durable job worker (required in production)
JOB_RUNNER_SECRET=
CRON_SECRET=
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=60
